# Copy this file to .env, fill both values in, and pass it to the container with
# "--env-file .env" or compose's "env_file:". Keeping it out of the command line
# keeps it out of your shell history; it does NOT keep it out of "docker inspect".
# See the Parameters section of README.md.
#
# .env is git-ignored. This file is not — never put a real password in it.

# The account the container creates for itself and grants OMSA's Administrator role to.
# It is a local account inside the container and grants nothing on the host.
OMSA_username=

# Its password. No default; the container refuses to start without it.
OMSA_password=
