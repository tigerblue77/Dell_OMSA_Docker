# Fake "adduser" used by the test suite.
#
# It stands in for the account creation the entrypoint performs, so that a run
# creates nothing on the machine the suite happens to be on, and so that a test
# can read back exactly what the entrypoint asked for.
#
# Every invocation is appended verbatim to $MOCK_ADDUSER_CALL_LOG, arguments
# included and in the order they were given : the options an entrypoint passes,
# and whether it passed "--" before a username, are part of what the tests are
# about.
#
# By default it also does what the real tool does, in the sandbox : it appends
# the account to $MOCK_ADDUSER_PASSWD_FILE, so that a second run of the
# entrypoint finds the user already there, the way a restarted container does.
#
# Recognized environment variables:
#   MOCK_ADDUSER_CALL_LOG        file the invocations are appended to
#   MOCK_ADDUSER_PASSWD_FILE     passwd file the created account is appended to.
#                                Unset, nothing is written anywhere
#   MOCK_ADDUSER_OUTPUT          what it prints (on stderr when it fails, the way
#                                the real tool reports a refusal)
#   MOCK_ADDUSER_EXIT_CODE       exit code (default 0)
#   MOCK_ADDUSER_SECOND_EXIT_CODE   exit code returned from the
#                                MOCK_ADDUSER_SWITCH_AFTER_CALLS+1-th call
#                                onwards, so that an entrypoint calling it twice
#                                can be made to see the second call refused
#   MOCK_ADDUSER_SWITCH_AFTER_CALLS  when to switch (default 1)

if [ -n "${MOCK_ADDUSER_CALL_LOG:-}" ]; then
  printf '%s\n' "adduser${*:+ $*}" >> "$MOCK_ADDUSER_CALL_LOG"
fi

EXIT_CODE="${MOCK_ADDUSER_EXIT_CODE:-0}"
if [ -n "${MOCK_ADDUSER_SECOND_EXIT_CODE:-}" ] && [ -n "${MOCK_ADDUSER_CALL_LOG:-}" ]; then
  # The current call is already in the log, so this counts it too
  CALL_NUMBER=$(wc -l < "$MOCK_ADDUSER_CALL_LOG")
  if [ "$CALL_NUMBER" -gt "${MOCK_ADDUSER_SWITCH_AFTER_CALLS:-1}" ]; then
    EXIT_CODE="$MOCK_ADDUSER_SECOND_EXIT_CODE"
  fi
fi

if [ "$EXIT_CODE" -ne 0 ]; then
  printf '%s' "${MOCK_ADDUSER_OUTPUT:-adduser: refused}" >&2
  exit "$EXIT_CODE"
fi

[ -n "${MOCK_ADDUSER_OUTPUT:-}" ] && printf '%s\n' "$MOCK_ADDUSER_OUTPUT"

# The username is the first argument that is not an option, which is how the
# real tool reads it -- and why an entrypoint that passes a username beginning
# with a dash, with no "--" in front of it, creates no account at all
USERNAME=""
for ARGUMENT in "$@"; do
  case "$ARGUMENT" in
    --) continue ;;
    -*) continue ;;
    *) USERNAME="$ARGUMENT"; break ;;
  esac
done

if [ -n "${MOCK_ADDUSER_PASSWD_FILE:-}" ] && [ -n "$USERNAME" ] && [ -f "$MOCK_ADDUSER_PASSWD_FILE" ]; then
  printf '%s:x:1000:1000::/home/%s:/bin/bash\n' "$USERNAME" "$USERNAME" >> "$MOCK_ADDUSER_PASSWD_FILE"
fi

exit 0
