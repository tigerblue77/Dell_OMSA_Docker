{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(shellcheck:*)",
      "Bash(hadolint Dockerfile)",
      "Bash(bash -n:*)",
      "Bash(sh -n:*)"
    ]
  }
}
